    {
      "path": "src/components/shadcn-space/animated-beam/animated-beam-03.css",
      "content": ".animated-beam-03-pulse {\r\n  stroke-dasharray: 16 200;\r\n  stroke-dashoffset: 16;\r\n  animation: animated-beam-03-flow 6s linear infinite;\r\n}\r\n\r\n/* Each spoke travels in a short slot of the cycle, staggered with animation-delay */\r\n@keyframes animated-beam-03-flow {\r\n  0% {\r\n    stroke-dashoffset: 16;\r\n  }\r\n  15%,\r\n  100% {\r\n    stroke-dashoffset: -100;\r\n  }\r\n}\r\n\r\n/* Soft ring on the hub every time a beam slides under it (about 0.6s into each beam) */\r\n.animated-beam-03-hub-ring {\r\n  animation: animated-beam-03-ring 1s ease-out 0.6s infinite;\r\n  opacity: 0;\r\n}\r\n\r\n@keyframes animated-beam-03-ring {\r\n  0% {\r\n    opacity: 0.6;\r\n    transform: scale(1);\r\n  }\r\n  100% {\r\n    opacity: 0;\r\n    transform: scale(1.35);\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .animated-beam-03-pulse {\r\n    animation: none;\r\n    stroke-dasharray: none;\r\n    opacity: 0.4;\r\n  }\r\n\r\n  .animated-beam-03-hub-ring {\r\n    display: none;\r\n  }\r\n}\r\n",
